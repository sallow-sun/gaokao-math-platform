# Configuration reference only; Python does NOT automatically load this file.
# Export variables locally; use EnvironmentFile in the production systemd unit.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCUMENT_WORKER_TOKEN=replace-with-a-new-random-secret-at-least-32-characters
DOCUMENT_DATA_DIR=/srv/mathsea/document-data
# Optional for offline use. Keep both empty until a paid pilot is explicitly wanted.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
LIBREOFFICE_BIN=/usr/bin/soffice

# Add ONLY these two settings to the existing Java backend environment:
# DOCUMENT_WORKER_URL=http://127.0.0.1:8091
# DOCUMENT_WORKER_TOKEN=<same shared secret as above>
